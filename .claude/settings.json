{
  "projectContext": {
    "name": "Freelo JS SDK",
    "description": "Official JavaScript/TypeScript SDK for Freelo.io API",
    "type": "npm-package"
  },
  "includeFiles": [
    "CLAUDE.md",
    "docs/phases/0-overview.md"
  ],

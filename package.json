{
  "name": "@freeloapp/js-sdk",
  "version": "1.0.0",
  "description": "Official JavaScript/TypeScript SDK for Freelo.io API",
  "license": "MIT",
  "author": "Freelo Bay s.r.o.",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/freeloapp/freelo-js-sdk.git"
  },
  "bugs": {
    "url": "https://gitlab.com/freeloapp/freelo-js-sdk/-/issues"
  },
  "homepage": "https://gitlab.com/freeloapp/freelo-js-sdk#readme",
  "keywords": [
    "freelo",
    "api",
    "sdk",
    "project-management",
    "typescript",
    "tasks",
    "time-tracking"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.11.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.2.0",
    "@vitest/coverage-v8": "^1.2.0"
  }
}
